  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Familienberatung hilft bei Herausforderungen in der Erziehung \r\nEltern
    wollen das Beste f\xFCr ihre Kinder. Doch Unsicherheiten k\xF6nnen die Beziehung
    zu den Kindern schwierig machen: Entwickelt sich unser Kind \"normal\", kann
    es seine F\xE4higkeiten entfalten und wie k\xF6nnen wir es als Eltern f\xF6rdern?
    Auch die Pubert\xE4t bringt neue Herausforderungen mit sich. Wenn du Fragen zur
    Erziehung hast oder dich in schwierigen Familiensituationen \xFCberfordert f\xFChlst,
    kannst du unsere Familienberatung in Anspruch nehmen. H\xE4ufig kommen Menschen
    in unsere Beratung bei:\r\n\r\nErziehungsfragen,\r\nEntwicklungsauff\xE4lligkeiten,\r\nFamilienkrisen,\r\nGewalt,
    Missbrauch und Misshandlung,\r\nFragen zur Mediennutzung ihrer Kinder oder\r\nProblemen
    in Kita, Kindergarten und Schule.\n\nLass dich jetzt von uns beraten\r\nRund
    1.500 qualifizierte Fachleute der Caritas beraten dich bei famili\xE4ren Problemen
    und beantworten Fragen zur Erziehung. Oft dauert es l\xE4nger, bis M\xFCtter
    oder V\xE4ter sich Unterst\xFCtzung von einer Beratungsstelle suchen. Manche
    haben Angst abgestempelt zu werden, oder das Gef\xFChl, eine schlechte Mutter
    oder schlechter Vater zu sein, wenn sie nicht alles allein schaffen. Wenn es
    dir auch so geht: L\xF6se dich von diesen Gedanken. Es geht um dich und das Wohl
    deiner Kinder. Wir von der Caritas m\xF6chten dich und deine Familie so fr\xFCh
    wie m\xF6glich unterst\xFCtzen \u2013 analog vor Ort oder digital in unserer
    Onlineberatung."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
